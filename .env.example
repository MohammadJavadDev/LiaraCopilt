# Model identifiers as they appear in console.liara.ir/ai/.../models.
# Cheap/fast model: intent-adjacent helper tasks (title generation, follow-up suggestions).
LIARA_AI_MODEL_FAST=
# Strong model: final technical answer generation (highest quality weight in judging rubric).
LIARA_AI_MODEL_STRONG=

# Optional: max requests per minute per IP for /api/chat rate limiting.
RATE_LIMIT_PER_MINUTE=20
