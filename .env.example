# Liara AI — OpenAI-compatible API credentials.
# Get these from console.liara.ir/ai (create a project, then an API key).
# See: https://docs.liara.ir/ai/quick-start
# NEVER put a real key on this line — this file is committed to git.
# Put the real value only in .env.local (already gitignored).
LIARA_AI_API_KEY=your-liara-ai-api-key
LIARA_AI_BASE_URL=https://ai.liara.ir/api/v1

# Model identifiers as they appear in console.liara.ir/ai/.../models.
# Cheap/fast model: intent-adjacent helper tasks (title generation, follow-up suggestions).
LIARA_AI_MODEL_FAST=
# Strong model: final technical answer generation (highest quality weight in judging rubric).
LIARA_AI_MODEL_STRONG=

# Optional: max requests per minute per IP for /api/chat rate limiting.
RATE_LIMIT_PER_MINUTE=20
